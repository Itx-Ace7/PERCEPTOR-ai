# Copy to .env and fill in when you have a key.
# The deterministic pipeline runs fully without this.
OPENROUTER_API_KEY=
PERCEPTOR_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional shared secret for the API. When set, requests need the x-api-key header (or ?api_key=).
PERCEPTOR_API_TOKEN=
# Set to 0 when this API is reachable from other devices. Local-path analysis is then refused.
PERCEPTOR_ALLOW_LOCAL_PATHS=
